<!-- question: q2 -->
<question type="multichoice">
  <name>
    <text>Ishikawa-Diagramm: Bauteile des Zeichenvorrats</text>
  </name>
  <questiontext format="html">
    <text><![CDATA[<p>Welche der folgenden Elemente gehören zum Zeichenvorrat eines vollständigen Ishikawa-Diagramms? (Mehrfachauswahl)</p>]]></text>
  </questiontext>
  <generalfeedback format="html">
    <text><![CDATA[<p>Ein vollständiges Ishikawa-Diagramm besteht aus Rückgrat, Wirkungskasten, Hauptast, Ursache und Unterursache. Swimlane, Gateway und Guard-Bedingung stammen aus anderen Notationen (Aktivitätsdiagramm/BPMN).</p>]]></text>
  </generalfeedback>
  <defaultgrade>4</defaultgrade>
  <penalty>0.3333333</penalty>
  <hidden>0</hidden>
  <idnumber></idnumber>
  <single>false</single>
  <shuffleanswers>true</shuffleanswers>
  <answernumbering>abc</answernumbering>
  <correctfeedback format="html"><text>Die Antwort ist richtig.</text></correctfeedback>
  <partiallycorrectfeedback format="html"><text>Die Antwort ist teilweise richtig.</text></partiallycorrectfeedback>
  <incorrectfeedback format="html"><text>Die Antwort ist falsch.</text></incorrectfeedback>
  <shownumcorrect/>

  <answer fraction="25" format="html">
    <text><![CDATA[<p>Rückgrat – die Hauptlinie mit Pfeil zum Wirkungskasten</p>]]></text>
  </answer>
  <answer fraction="25" format="html">
    <text><![CDATA[<p>Wirkungskasten – benennt das zu untersuchende Problem neutral</p>]]></text>
  </answer>
  <answer fraction="25" format="html">
    <text><![CDATA[<p>Hauptast – führt schräg auf das Rückgrat zu einer Kategorie</p>]]></text>
  </answer>
  <answer fraction="25" format="html">
    <text><![CDATA[<p>Ursache – Nebenast mit einer konkreten möglichen Ursache</p>]]></text>
  </answer>
  <answer fraction="-33.33333" format="html">
    <text><![CDATA[<p>Swimlane – Bahn für Zuständigkeiten in Aktivitätsdiagrammen</p>]]></text>
  </answer>
  <answer fraction="-33.33333" format="html">
    <text><![CDATA[<p>Gateway – Verzweigung des Sequenzflusses in BPMN</p>]]></text>
  </answer>
  <answer fraction="-33.33333" format="html">
    <text><![CDATA[<p>Guard-Bedingung – Bedingung an einem Übergang zwischen Zuständen</p>]]></text>
  </answer>
</question>

