<question type="multichoice">
  <name>
    <text>Ishikawa-Diagramm: Formulierung des Wirkungskastens</text>
  </name>
  <questiontext format="html">
    <text><![CDATA[<p>Welche Aussagen zur richtigen Formulierung des Wirkungskastens sind zutreffend? (Mehrfachauswahl)</p>]]></text>
  </questiontext>
  <generalfeedback format="html">
    <text><![CDATA[<p>Der Wirkungskasten steht am rechten Ende des Rückgrats und benennt das Problem konkret, messbar und ohne Schuldzuweisung.</p>]]></text>
  </generalfeedback>
  <defaultgrade>3</defaultgrade>
  <penalty>0.3333333</penalty>
  <hidden>0</hidden>
  <idnumber></idnumber>
  <single>false</single>
  <shuffleanswers>true</shuffleanswers>
  <answernumbering>abc</answernumbering>
  <correctfeedback format="html"><text>Die Antwort ist richtig.</text></correctfeedback>
  <partiallycorrectfeedback format="html"><text>Die Antwort ist teilweise richtig.</text></partiallycorrectfeedback>
  <incorrectfeedback format="html"><text>Die Antwort ist falsch.</text></incorrectfeedback>
  <shownumcorrect/>

  <answer fraction="33.33333" format="html">
    <text><![CDATA[<p>Die Formulierung sollte konkret und möglichst messbar sein, zum Beispiel mit einer Kennzahl.</p>]]></text>
  </answer>
  <answer fraction="33.33333" format="html">
    <text><![CDATA[<p>Die Formulierung sollte neutral sein und keine Schuldzuweisung an bestimmte Personen enthalten.</p>]]></text>
  </answer>
  <answer fraction="33.33333" format="html">
    <text><![CDATA[<p>Der Wirkungskasten steht am rechten Ende des Rückgrats, auf das die Pfeile aller Ursachen zeigen.</p>]]></text>
  </answer>
  <answer fraction="-33.33333" format="html">
    <text><![CDATA[<p>Die Formulierung sollte möglichst allgemein bleiben, damit sie zu vielen Problemen passt.</p>]]></text>
  </answer>
  <answer fraction="-33.33333" format="html">
    <text><![CDATA[<p>Im Wirkungskasten wird die vermutete Lösung des Problems formuliert.</p>]]></text>
  </answer>
  <answer fraction="-33.33333" format="html">
    <text><![CDATA[<p>Der Wirkungskasten steht am linken Anfang des Rückgrats, von dem die Pfeile wegzeigen.</p>]]></text>
  </answer>
</question>

